{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "Bundler",
        "lib": [
            "ES2020",
            "DOM"
        ],
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "sourceMap": true,
        "noEmitOnError": true
